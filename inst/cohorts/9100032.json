  "InclusionRules": [
    {
      "name": "Not during an inpatient stay",
      "description": "Zero inpatient visits (9201 Inpatient Visit, 262 Emergency Room and Inpatient Visit, with descendants) that span the antihypertensive exposure start date: a visit that started on or before that date (StartWindow, unbounded back to day 0) AND ended on or after it (EndWindow, day 0 onward). Same rule as cohort 9100007 (insulin): medication given or prescribed while the patient was NOT hospitalized, so drugs started for an acute inpatient indication do not count. Exposures with no visit link are kept, ED-only visits are not excluded. Implementation note: the EndWindow must have UseEventEnd = true so Circe compares the visit END date; without it Circe tests the visit start date twice and only visits starting on the exposure date are excluded (caught by tests/regression/test_insulin_item.R).",
      "expression": {
        "Type": "ALL",
        "CriteriaList": [
          {
            "Criteria": {
              "VisitOccurrence": {
                "CodesetId": 1
              }
            },
